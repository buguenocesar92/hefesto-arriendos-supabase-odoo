# Copiar a .env. No subir .env a Git.
# Generar contraseña aleatoria de al menos 16 caracteres.
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://arriendos.tu-dominio.cl
COOKIE_SECURE=true
# Para prueba local: PUBLIC_ORIGIN=http://localhost:3080 y COOKIE_SECURE=false

# Supabase: usar compose.supabase.yaml
STORAGE_BACKEND=supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave sb_secret_... (preferida), o legacy service_role. Nunca anon/publishable.
SUPABASE_SECRET_KEY=
WORKSHOP_ID=main
